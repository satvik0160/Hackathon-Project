# DevAstra Environment Variables Template
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local or any real secrets to source control.

# InsForge BaaS Backend URL & Public Anonymous Key
# Note: The anon key is safe for public client use with proper Row Level Security (RLS).
VITE_INSFORGE_URL=https://your-project.us-west.insforge.app
VITE_INSFORGE_ANON_KEY=your-insforge-anon-key

# Optional local backend API URL (defaults to proxy / edge function)
VITE_API_URL=http://localhost:8000
