import React, { useState, useEffect, useMemo, useRef } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { Sparkles, BookOpen, PlayCircle, CheckCircle2, Lock, ArrowRight } from 'lucide-react';
import { useAuth } from '../../contexts/AuthContext';
import { learningService, insforge } from '../../services/api';
import { useNavigate } from 'react-router-dom';
import { toast } from 'react-hot-toast';

const Roadmap = () => {
  const { user } = useAuth();
  const navigate = useNavigate();
  const [nodes, setNodes] = useState([]);
  const [loading, setLoading] = useState(true);
  const [generating, setGenerating] = useState(false);
  const [selectedNode, setSelectedNode] = useState(null);
  const [userStats, setUserStats] = useState({ tests: 0, resources: 0 });

  useEffect(() => {
    fetchRoadmap();
    fetchUserStats();
  }, []);

  const fetchUserStats = async () => {
    try {
      if (!user?.id) return;
      // Fetch user's planner targets to count how many tests and videos they did
      const { data } = await insforge.from('daily_planner_targets').select('*').eq('user_id', user.id).eq('status', 'completed');
      let tests = 0;
      let resources = 0;
      if (data) {
        data.forEach(t => {
          if (t.type === 'assessment') tests++;
          if (t.type === 'video' || t.type === 'learning' || t.type === 'article') resources++;
        });
      }
      setUserStats({ tests, resources });
    } catch (e) {
      console.error(e);
    }
  };

  const fetchRoadmap = async ({ forceRebuild = false, persist = false } = {}) => {
    try {
      setLoading(true);
      const res = await learningService.getPaths();
      const pathNodes = res.data?.nodes || res.data || [];
      // Same template logic as before, just copying it over
      // Actually we can just call getPaths and it will do the logic inside api.js, wait no, the logic was in Roadmap.jsx.
